# ---------------------------------------------------------------------------
# apps/api + apps/workers environment.
#
# Copy to `.env` and fill in. `.env` is git-ignored; THIS file is committed and
# must never contain a real value — names and shapes only.
#
#   cp apps/api/.env.example apps/api/.env
#
# Secrets are loaded as pydantic `SecretStr`, so they cannot be printed,
# logged, or serialised into an error response by accident.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=local            # local | test | staging | production
# Blank lets ENVIRONMENT decide: INFO on staging and production, DEBUG on
# local and test. Set it (DEBUG | INFO | WARNING | ERROR | CRITICAL) to override.
LOG_LEVEL=

# --- datastores ------------------------------------------------------------
# asyncpg driver. Note there is deliberately NO synchronous driver in this
# project: psycopg2 and psycopg3 are both LGPL-3.0, which the dependency-licensing rule
# puts on the stop-and-ask list. Alembic runs through asyncpg too.
DATABASE_URL=postgresql+asyncpg://avp:avp@127.0.0.1:5432/avp

# /0 API sessions, /1 Celery broker, /2 Celery results. Separated so that
# flushing a wedged queue does not sign every user out.
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to /1 and /2 of REDIS_URL.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- auth ------------------------------------------------------------------
# Signing secret for CSRF tokens and invitation links. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Boot FAILS in staging/production if this is still the dev placeholder.
APP_SECRET=dev-only-insecure-secret-change-me

SESSION_TTL_SECONDS=1209600  # 14 days
# SESSION_TTL_SECONDS is the ABSOLUTE lifetime of a session, counted from sign-in however much it is
# used, and the session cookie's Max-Age. Lowering it also shortens sessions that are already open;
# raising it does not lengthen one past the end it was minted with. A session also ends after
# SESSION_IDLE_SECONDS without use (72 hours); use refreshes that clock, but never past the
# absolute end, and is written to Redis at most once per SESSION_TOUCH_INTERVAL_SECONDS (1 hour).
# NOT secrets. Ranges: IDLE 900 to 2592000; TOUCH_INTERVAL 60 to 86400. A value outside its range
# stops the API from starting, naming the setting. An idle window above SESSION_TTL_SECONDS is cut
# to it, and an interval above half the idle window is cut to half of it. Defaults shown:
# SESSION_IDLE_SECONDS=259200
# SESSION_TOUCH_INTERVAL_SECONDS=3600
# At most this many sessions per user (1 to 100): a sign-in over it ends the user's oldest session.
# SESSION_MAX_PER_USER=10
SESSION_COOKIE_NAME=avp_session
SESSION_COOKIE_SECURE=false  # forced true in staging/production
# The cookie is always SameSite=Lax with no Domain (the web app serves the API
# under its own origin, so it is first-party), and is sent as
# `__Host-avp_session` when Secure is on, `avp_session` on local http.

# Argon2id cost. Defaults follow OWASP's recommended second option.
# Raising these is safe: existing hashes upgrade transparently on next login.
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST_KIB=19456
ARGON2_PARALLELISM=1
# Argon2 hashes/verifies allowed at once per process (each holds ~19 MiB).
ARGON2_MAX_CONCURRENCY=2
# Seconds a request waits for an Argon2 slot before a 503.
ARGON2_QUEUE_TIMEOUT_SECONDS=10
# A reset link or an invitation being redeemed is claimed in Redis, so one hash runs per link at a
# time. If the request dies, the claim ends after the queue timeout above plus this many seconds.
REDEEM_CLAIM_MARGIN_SECONDS=5

# --- CORS ------------------------------------------------------------------
# Comma-separated. The web app's origin(s): the Origin check's allow-list for
# writes, and CORS's list (a wildcard is rejected by browsers with credentials).
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- request body size and time (A8b) ----------------------------------------
# The most bytes of a request body the API takes. Over its limit a request is answered 413
# before the body is read or parsed. NOT secrets. Each has its own range, and a value outside
# it (or a blank one) stops the API from starting, naming the setting. Defaults shown:
#   MAX_REQUEST_BODY_BYTES         65536 (64 KiB) for every route but two. 65536 to 1048576.
#   MAX_OTHER_SITES_BODY_BYTES     524288 (512 KiB) for PUT /clients/{clientId}/other-sites.
#                                  At most 8388608.
#   MAX_STRIPE_WEBHOOK_BODY_BYTES  1048576 (1 MiB) for POST /billing/webhook. 262144 to 8388608.
#                                  Stripe documents no maximum event size, so this is a generous
#                                  choice; too low a value is refused again at each of Stripe's
#                                  retries over three days.
# The three also have to agree, and where they do not the API STARTS ANYWAY and applies the floor:
# the webhook's limit is raised to the default, and the other-sites one to the default or to
# 207657, the largest body its schema allows, whichever is more. Each limit raised this way is
# logged once at start as config.body_limit_raised (setting, configured, effective, reason).
# MAX_REQUEST_BODY_BYTES=65536
# MAX_OTHER_SITES_BODY_BYTES=524288
# MAX_STRIPE_WEBHOOK_BODY_BYTES=1048576
# How long a body may take to arrive, in seconds, from the first read of it: a body not whole by
# then is answered 408 and its connection closed. 5 to 120. Every route, the webhook included.
# REQUEST_BODY_TIMEOUT_SECONDS=30

# --- outbound email (Epic 9.13) ---------------------------------------------
# OPTIONAL, and blank counts as unset. Unset is a supported mode, not a
# misconfiguration: nothing is sent and nothing is logged in its place. The
# reset response says email is not set up (the same for every address), and
# an invitation hands its link back to the inviter to send. Set it to deliver
# mail; it needs a verified sending domain at Resend.
RESEND_API_KEY=
EMAIL_FROM=no-reply@localhost
PASSWORD_RESET_TTL_SECONDS=3600

# Email the user who started a scan when it finishes (F1, 2026-10-06): a link to the
# report, a plain "did not finish" note, and a second email when the scan raised alerts.
# OFF by default, and blank is off. Even on, nothing is sent while RESEND_API_KEY is
# unset. Each user can opt out in Settings. NOT a secret.
EMAIL_SCAN_NOTIFICATIONS=false

# --- public share links (Epic 9.8) ------------------------------------------
# Where the WEB app is reachable from outside. Used to build the copyable URL
# returned by POST /scans/{scanId}/share. Never derived from the request Host
# header — that is attacker-controlled, and a share link built from a spoofed
# Host is a phishing URL carrying a real token.
PUBLIC_WEB_BASE_URL=http://localhost:3000

# --- seats -----------------------------------------------------------------
DEFAULT_SEAT_LIMIT=3
# Seven days. Deliberately longer than PASSWORD_RESET_TTL_SECONDS above: an
# invitation is an onboarding link for someone not expecting it, a reset is a
# recovery key for an account that may be under attack. See config.py.
INVITATION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Third-party providers (product-spec.md §5.1).
#
# All OPTIONAL at Epic 1 — there is no scan pipeline yet, so requiring these to
# boot would block local development on credentials nobody needs. Each is
# validated at point of use from Epic 2 onward, with an error naming the
# variable to set.
#
# NEVER commit real values. Use the deployment secret store in staging/prod.
# ---------------------------------------------------------------------------

# SERP data — Epic 3 competitor discovery
SERPAPI_KEY=

# LLM providers — Epic 2 industry classification, Epic 4 prompt generation,
# Epic 8 fix generation
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI answer engines — Epic 4 engine runner
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Billing — Epic 9.15. Stripe subscriptions.
#
# OPTIONAL, exactly like every provider key above: an API that refuses to boot
# without a payment processor is one nobody can run locally to work on anything
# else. Each is validated at point of use, with an error naming the variable.
#
# THESE ARE TEST-MODE KEYS AND THE CODE DOES NOT KNOW THE DIFFERENCE.
# There is no live/test flag anywhere in the codebase and no branch that
# behaves differently on an sk_live_ key. Going live is swapping these values —
# a founder decision, made once Stripe's business verification is done.
# ---------------------------------------------------------------------------

# Secret key. sk_test_... today. NEVER commit a real value here.
STRIPE_SECRET_KEY=

# The Price object checkout subscribes against — one plan, $150/month: repriced
# to $150 on 2026-10-04 (founder decision); it was $160 from 2026-09-22 and $29
# before. A $160 test-mode Price has existed since 2026-09-23 (`price_1UIh3b…`)
# and the $29.00 one from Epic 9.15 (`price_1U9For…`) is still active; a $150
# Price is the founder's to create in the Stripe dashboard. Name the $150 one
# here AND on Render, or checkout subscribes at another price while the page
# says $150. A deployed API (staging or production) reads this Price back at start
# and every hour, and logs `billing.price_mismatch` when it is not an active,
# licensed US$150 a month Price; a local API never calls Stripe for it.
# NOT a secret: a Price id identifies a published product and appears in
# client-side code in most Stripe integrations. It is here for completeness,
# not for confidentiality.
STRIPE_PRICE_ID=

# The free trial, in days — 2026-10-04, founder decision: a trial with the card
# taken at checkout, charged on the day it ends unless the agency cancels. 0 is
# NO TRIAL, and is the default: with 0 checkout is exactly what it was before this
# setting existed. Above 0, an agency that has never had a subscription gets a
# trial of this many days (one per agency, ever), and the public pages say "the
# first N days after you subscribe are free" from this number, read through
# GET /billing/plan, so it is stated in one place. 0 to 730 whole days (Stripe's limit); any other value
# stops the API from starting. NOT a secret. Turn it on here AND on Render; the
# Stripe endpoint can also send customer.subscription.trial_will_end, which the
# API only logs.
STRIPE_TRIAL_DAYS=0

# Sign-ins the scan allowance (one free, then forty a month) does not apply
# to — the platform operator. Comma-separated, case-insensitive. EMPTY by
# default, here and in config.py: a deployment exempts nobody until this is
# set. A listed address is exempt only if that user also signs in with
# Google — an unverified email is not proof of identity.
# NOT a secret: an email address, and the gate is enforced server-side.
SCAN_ALLOWANCE_EXEMPT_EMAILS=

# Platform-wide daily caps on new scans (UTC day). 0 refuses every new scan: the spend kill switch.
MAX_SCANS_PER_DAY_PLATFORM=60
MAX_SIGNUP_FREE_SCANS_PER_DAY=20

# Paid AI calls outside a scan (F3). Per client per hour / per scan cooldown / per agency per UTC
# day, then platform-wide daily caps (0 refuses every new call of that kind).
PROMPT_RUNS_PER_CLIENT_PER_HOUR=30
FIX_REGENERATE_COOLDOWN_SECONDS=3600
CLASSIFICATIONS_PER_AGENCY_PER_DAY=20
MAX_PROMPT_RUNS_PER_DAY_PLATFORM=300
MAX_FIX_RUNS_PER_DAY_PLATFORM=100
MAX_CLASSIFICATIONS_PER_DAY_PLATFORM=200
MAX_FREE_CLASSIFICATIONS_PER_DAY_PLATFORM=60
PROMPT_RUNS_PER_AGENCY_PER_DAY=100
FIX_RUNS_PER_AGENCY_PER_DAY=30
CLASSIFICATIONS_PER_UNPAID_AGENCY_PER_DAY=5

# Webhook signing secret. Printed by `stripe listen --forward-to \
#   localhost:8000/api/v1/billing/webhook`, or shown in the dashboard for a
# deployed endpoint. Unset is supported and is NOT a permissive mode: with no
# secret the webhook REFUSES every request rather than trusting an unverified
# payload. See services/billing.py:verify_webhook.
STRIPE_WEBHOOK_SECRET=

# Google sign-in (Epic 20). From a Google Cloud Console OAuth 2.0 client. All
# three must be set for the button to work; unset, /auth/google/start answers
# 503 and the password flow is unaffected. The redirect URL must match the
# Console EXACTLY, scheme and port included.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# In production this must be the WEB app's address,
# https://<web host>/api/v1/auth/google/callback, because the callback sets the
# session cookie on whatever host serves it and the cookie must land on the web
# host. Locally the 8000 value keeps working because cookies ignore the port.
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_SIGN_IN_TTL_SECONDS=600

# Where the signed-in web app's "Send feedback" link writes to (2026-10-06). Blank,
# the default, is NO LINK: nothing a user sees changes. One email address; anything
# else stops the API from starting, with a message that names this variable and
# not the value. NOT a secret: every signed-in user is shown it (GET /auth/me
# carries it as feedbackEmail), and the link opens an email to it with the SHAPE
# of the page in the subject, never an id, a token or a name. Set it on the API
# service only; the web has no variable for it.
FEEDBACK_EMAIL=

# Whether the signed-in report offers "Download figures (CSV)" (2026-10-06). Off, the
# default, the route answers 404 and the web draws no link: nothing a user sees changes.
# On, the file carries the figures the signed-in report already shows, for a finished
# scan, and a share link never has it. true or false (blank is false); any other value
# stops the API from starting, with a message that names this variable and not the
# value. NOT a secret. Set it on the API service only; the web has no variable for it.
REPORT_CSV_ENABLED=false

# Whether the API starts a client's scan by itself every month (F2, 2026-10-06), for the
# clients an owner or admin has switched "Rescan every month" on for. Off, the default, no
# loop runs and the client screen draws no switch: nothing a user sees changes. On, a loop
# wakes every 10 minutes and starts at most one due scan through the Run button's own start
# path, so the scan allowance (and the plan) applies. true or false (blank is false); any
# other value stops the API from starting, with a message that names this variable and not
# the value. NOT a secret. Set it on the API service only; the web has no variable for it.
AUTO_RESCAN_ENABLED=false

# Rate limits on login, sign-up and password-reset requests (Redis-backed fixed
# windows, per email and per IP). Every sign-up and reset attempt counts; a login counts only if it fails.
# Redis down: login and sign-up answer 503, reset-request fails open. Defaults shown.
# Login is limited per IP only (a fixed window, answered 429). Per address it is SLOWED, never
# locked and never answered 429: after LOGIN_SLOWDOWN_AFTER_FAILURES failures within
# LOGIN_SLOWDOWN_WINDOW_SECONDS the address's next attempt is only evaluated after
# LOGIN_SLOWDOWN_FIRST_WAIT_SECONDS, doubling at every failed attempt up to
# LOGIN_SLOWDOWN_MAX_WAIT_SECONDS. An attempt during a wait is answered as a wrong password.
# Ranges: AFTER_FAILURES 1 to 20; the three SECONDS settings 1 to 86400 (a day). A value outside
# its range stops the API from starting, naming the setting. A first wait above the longest is cut.
# LOGIN_LIMIT_PER_EMAIL is gone; one left set on a deployed service is ignored, not an error.
# LOGIN_LIMIT_PER_IP=30
# LOGIN_WINDOW_SECONDS=900
# LOGIN_SLOWDOWN_AFTER_FAILURES=5
# LOGIN_SLOWDOWN_WINDOW_SECONDS=900
# LOGIN_SLOWDOWN_FIRST_WAIT_SECONDS=60
# LOGIN_SLOWDOWN_MAX_WAIT_SECONDS=900
# GOOGLE_START_LIMIT_PER_IP=30
# GOOGLE_START_WINDOW_SECONDS=900
# The public share routes (POST /reports/shared, /reports/shared/pdf): per source IP, fail open on a Redis error.
# SHARED_REPORT_LIMIT_PER_IP=60
# SHARED_PDF_LIMIT_PER_IP=10
# SHARED_WINDOW_SECONDS=600
# Report PDFs rendered at once per process (on a worker thread), and the wait for a slot before a 503.
# PDF_RENDER_MAX_CONCURRENCY=1
# PDF_RENDER_QUEUE_TIMEOUT_SECONDS=20
# REDIS_MEMORY_WARN_RATIO=0.5
# SIGNUP_LIMIT_PER_EMAIL=5
# SIGNUP_LIMIT_PER_IP=10
# SIGNUP_WINDOW_SECONDS=3600
# RESET_LIMIT_PER_EMAIL=3
# RESET_LIMIT_PER_IP=10
# RESET_WINDOW_SECONDS=3600
# Header carrying the real client IP. Empty = the connection's client host
# (uvicorn --proxy-headers, leftmost X-Forwarded-For). Render is behind
# Cloudflare, which sets CF-Connecting-IP; confirm all traffic comes through
# Cloudflare before setting CLIENT_IP_HEADER=CF-Connecting-IP. NEVER set it to
# X-Forwarded-For (its first entry is client-controlled). When set, a missing
# or unparseable value shares one bucket. Limits must be >= 1.
# CLIENT_IP_HEADER=
