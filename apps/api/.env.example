# ---------------------------------------------------------------------------
# apps/api + apps/workers environment.
#
# Copy to `.env` and fill in. `.env` is git-ignored; THIS file is committed and
# must never contain a real value — names and shapes only.
#
#   cp apps/api/.env.example apps/api/.env
#
# Secrets are loaded as pydantic `SecretStr`, so they cannot be printed,
# logged, or serialised into an error response by accident.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=local            # local | test | staging | production
LOG_LEVEL=INFO

# --- datastores ------------------------------------------------------------
# asyncpg driver. Note there is deliberately NO synchronous driver in this
# project: psycopg2 and psycopg3 are both LGPL-3.0, which the dependency-licensing rule
# puts on the stop-and-ask list. Alembic runs through asyncpg too.
DATABASE_URL=postgresql+asyncpg://avp:avp@127.0.0.1:5432/avp

# /0 API sessions, /1 Celery broker, /2 Celery results. Separated so that
# flushing a wedged queue does not sign every user out.
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to /1 and /2 of REDIS_URL.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- auth ------------------------------------------------------------------
# Signing secret for CSRF tokens and invitation links. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Boot FAILS in staging/production if this is still the dev placeholder.
APP_SECRET=dev-only-insecure-secret-change-me

SESSION_TTL_SECONDS=1209600  # 14 days
SESSION_COOKIE_NAME=avp_session
SESSION_COOKIE_SECURE=false  # forced true in staging/production
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=.example.com

# Argon2id cost. Defaults follow OWASP's recommended second option.
# Raising these is safe: existing hashes upgrade transparently on next login.
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST_KIB=19456
ARGON2_PARALLELISM=1

# --- CORS ------------------------------------------------------------------
# Comma-separated. Session cookies require explicit origins — a wildcard is
# rejected by browsers when credentials are allowed.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- outbound email (Epic 9.13) ---------------------------------------------
# OPTIONAL. Unset is a supported mode, not a misconfiguration: the password
# reset email is logged instead of sent, and the endpoint answers identically
# either way. Set it to actually deliver mail.
RESEND_API_KEY=
EMAIL_FROM=no-reply@localhost
PASSWORD_RESET_TTL_SECONDS=3600

# --- public share links (Epic 9.8) ------------------------------------------
# Where the WEB app is reachable from outside. Used to build the copyable URL
# returned by POST /scans/{scanId}/share. Never derived from the request Host
# header — that is attacker-controlled, and a share link built from a spoofed
# Host is a phishing URL carrying a real token.
PUBLIC_WEB_BASE_URL=http://localhost:3000

# --- seats -----------------------------------------------------------------
DEFAULT_SEAT_LIMIT=3
# Seven days. Deliberately longer than PASSWORD_RESET_TTL_SECONDS above: an
# invitation is an onboarding link for someone not expecting it, a reset is a
# recovery key for an account that may be under attack. See config.py.
INVITATION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Third-party providers (product-spec.md §5.1).
#
# All OPTIONAL at Epic 1 — there is no scan pipeline yet, so requiring these to
# boot would block local development on credentials nobody needs. Each is
# validated at point of use from Epic 2 onward, with an error naming the
# variable to set.
#
# NEVER commit real values. Use the deployment secret store in staging/prod.
# ---------------------------------------------------------------------------

# SERP data — Epic 3 competitor discovery
SERPAPI_KEY=

# LLM providers — Epic 2 industry classification, Epic 4 prompt generation,
# Epic 8 fix generation
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI answer engines — Epic 4 engine runner
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Billing — Epic 9.15. Stripe subscriptions.
#
# OPTIONAL, exactly like every provider key above: an API that refuses to boot
# without a payment processor is one nobody can run locally to work on anything
# else. Each is validated at point of use, with an error naming the variable.
#
# THESE ARE TEST-MODE KEYS AND THE CODE DOES NOT KNOW THE DIFFERENCE.
# There is no live/test flag anywhere in the codebase and no branch that
# behaves differently on an sk_live_ key. Going live is swapping these values —
# a founder decision, made once Stripe's business verification is done.
# ---------------------------------------------------------------------------

# Secret key. sk_test_... today. NEVER commit a real value here.
STRIPE_SECRET_KEY=

# The Price object checkout subscribes against — one plan, $29/month.
# NOT a secret: a Price id identifies a published product and appears in
# client-side code in most Stripe integrations. It is here for completeness,
# not for confidentiality.
STRIPE_PRICE_ID=

# Webhook signing secret. Printed by `stripe listen --forward-to \
#   localhost:8000/api/v1/billing/webhook`, or shown in the dashboard for a
# deployed endpoint. Unset is supported and is NOT a permissive mode: with no
# secret the webhook REFUSES every request rather than trusting an unverified
# payload. See services/billing.py:verify_webhook.
STRIPE_WEBHOOK_SECRET=
